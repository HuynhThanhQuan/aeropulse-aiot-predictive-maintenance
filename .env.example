# Copy to .env and replace both placeholders before starting Compose.
# Local classroom demo only; never commit .env.
INFLUXDB_PASSWORD=REPLACE_WITH_LOCAL_DEMO_PASSWORD
INFLUXDB_TOKEN=REPLACE_WITH_LOCAL_DEMO_TOKEN
DASHBOARD_PORT=8010
MQTT_PORT=1883
INFLUXDB_PORT=8086
# Host-side evidence capture reads exported variables, not .env automatically.
MQTT_HOST=localhost
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=aiot
INFLUXDB_BUCKET=telemetry
# dashboard/create_general_dashboard.py reads INFLUXDB_URL, INFLUXDB_ORG,
# INFLUXDB_BUCKET, and INFLUXDB_TOKEN. It does not read INFLUXDB_PASSWORD.
# Optional freshness window shared by the GENERAL_DASHBOARD KPI cards and tables.
# FLEET_STALE_AFTER_S=60
MODEL_PATH=models/tiny_cnn_int8.onnx
METADATA_PATH=models/metadata.json
